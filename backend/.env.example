# AgriNexus Backend Environment Configuration Template
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required for AI Copilot, Crop Disease Vision, and Soil Health Card OCR in LIVE mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional: For live daily mandi rates from data.gov.in AGMARKNET API
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
